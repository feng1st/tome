// Figure table: every figure a creature may present — id, texture,
// frame grid, and the anim table keyed by anim name. Load assigns each
// id a runtime handle in entry order; handles are unstable across loads
// (entry order decides them), so saved data must translate through the
// id mapping, never store raw handles. Frame size is per entry (creature
// sheets are not world-tile sized); frame indices address the row-major
// grid and must stay inside columns × rows. Every entry must define an
// `idle` anim; undefined anims fall back to it at playback. Each anim
// entry names its frames, its rate, and whether it loops — looping
// tables wrap, non-looping tables clamp at the last frame.
[
    (
        figure: "warrior",
        texture: "warrior.png",
        frame_size: (12, 15),
        columns: 21,
        rows: 8,
        anims: [
            // Idle breathes between frames 0 and 1.
            ( anim: idle,   frames: [0, 0, 0, 1, 0, 0, 1, 1],        fps: 8.0,  looped: true ),
            // Run cycles frames 2..7.
            ( anim: run,    frames: [2, 3, 4, 5, 6, 7],              fps: 20.0, looped: true ),
            // Attack swings through the extended poses back to rest.
            ( anim: attack, frames: [13, 14, 15, 0],                 fps: 15.0, looped: false ),
            // Die falls and settles on the lying pose.
            ( anim: die,    frames: [8, 9, 10, 11, 12, 11],          fps: 20.0, looped: false ),
        ],
    ),
    (
        figure: "giant_white_rat",
        texture: "rat.png",
        frame_size: (16, 15),
        columns: 16,
        rows: 2,
        anims: [
            // The sheet's second row is the white variant; idle breathes
            // slowly between its frames 16 and 17.
            ( anim: idle,   frames: [16, 16, 16, 17],                fps: 2.0,  looped: true ),
            // Run scampers along the white-variant row.
            ( anim: run,    frames: [22, 23, 24, 25, 26],            fps: 10.0, looped: true ),
            // Attack bites through the lunge poses back to rest; die
            // keels over — both on the white-variant row.
            ( anim: attack, frames: [18, 19, 20, 21, 16],            fps: 15.0, looped: false ),
            ( anim: die,    frames: [27, 28, 29, 30],                fps: 10.0, looped: false ),
        ],
    ),
]
